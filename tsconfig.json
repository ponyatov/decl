{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./js/ts",
        "rootDir": "./ts",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["ts/*.ts"],
    "exclude": ["node_modules"]
}
