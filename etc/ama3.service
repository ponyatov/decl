[Unit]
Description=Configure ttyAMA3 serial port to 115200 8n1
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/stty -F /dev/ttyAMA3 115200 cs8 -parenb -cstopb -ignpar -crtscts raw -echo min 1 time 1

[Install]
WantedBy=multi-user.target
